APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/tactical_analyst
REDIS_URL=redis://redis:6379/0

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_PATH=./data/object_store
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=tactical-analyst
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_BACKOFF_SECONDS=0.5

SOCCER_DATA_PROVIDER=statsbomb_open
STATSBOMB_OPEN_DATA_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data

REPORT_PROMPT_VERSION=v1

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CACHE_TTL_SECONDS=3600
ANALYTICS_VERSION=analytics_v1
MAX_CLAIM_REPAIR_ATTEMPTS=1
